# Database
POSTGRES_USER=econometrica
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=econometrica
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://econometrica:change-me-locally@localhost:5433/econometrica
TEST_DATABASE_URL=postgresql+asyncpg://econometrica:change-me-locally@localhost:5433/econometrica_test

# Application
ECONOMETRICA_STORAGE_DIR=./storage
ECONOMETRICA_SECRET_KEY=generate-with-openssl-rand-hex-32
ECONOMETRICA_LOG_LEVEL=INFO

# Where a run's prices come from.
#   none       refuse, with an explanation. The default: a workbench whose
#              numbers are supposed to trace to real data should not quietly
#              substitute anything.
#   yahoo      real dividend-adjusted daily closes through yfinance, cached
#              on disk under ECONOMETRICA_STORAGE_DIR for a day.
#   synthetic  generate reproducible random walks, so the agent pipeline can
#              be run with no network at all. Every run built on them carries a
#              `synthetic_data` risk flag — they are not market data.
ECONOMETRICA_PRICE_SOURCE=none

# Which provider a run uses when web search is enabled for a project or chat.
# Search is off by default and is a per-project setting a chat can override;
# this only decides *which* engine answers when it is on.
#   duckduckgo  no API key. Reads the HTML results page, so it has no API
#               contract behind it and is the fragile part. The default.
#   brave       a documented JSON API. Needs BRAVE_API_KEY.
# Nothing search returns can become a number: the grounding gate admits only
# values a tool in `econ/` computed, and a figure read on a web page is exactly
# as ungrounded as one a model invented.
ECONOMETRICA_SEARCH_PROVIDER=duckduckgo
BRAVE_API_KEY=

# LLM providers — all optional, configured in the UI as well
OLLAMA_BASE_URL=http://localhost:11434
NVIDIA_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
